<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ana zar gövdesi -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="#333333" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    
    <!-- Sol sütun nokta 1 -->
    <item android:gravity="left|top" android:left="4dp" android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#222222" />
            <size android:width="3dp" android:height="3dp" />
        </shape>
    </item>
    
    <!-- Sol sütun nokta 2 -->
    <item android:gravity="left|center_vertical" android:left="4dp">
        <shape android:shape="oval">
            <solid android:color="#222222" />
            <size android:width="3dp" android:height="3dp" />
        </shape>
    </item>
    
    <!-- Sol sütun nokta 3 -->
    <item android:gravity="left|bottom" android:left="4dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#222222" />
            <size android:width="3dp" android:height="3dp" />
        </shape>
    </item>
    
    <!-- Sağ sütun nokta 1 -->
    <item android:gravity="right|top" android:right="4dp" android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#222222" />
            <size android:width="3dp" android:height="3dp" />
        </shape>
    </item>
    
    <!-- Sağ sütun nokta 2 -->
    <item android:gravity="right|center_vertical" android:right="4dp">
        <shape android:shape="oval">
            <solid android:color="#222222" />
            <size android:width="3dp" android:height="3dp" />
        </shape>
    </item>
    
    <!-- Sağ sütun nokta 3 -->
    <item android:gravity="right|bottom" android:right="4dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#222222" />
            <size android:width="3dp" android:height="3dp" />
        </shape>
    </item>
</layer-list>